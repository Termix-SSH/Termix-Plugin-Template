{
  "id": "hello-world",
  "name": "Hello World",
  "version": "1.0.0",
  "description": "A minimal Termix plugin: one tab, one route, one setting and one table.",
  "author": {
    "name": "Your Name"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/your-org/termix-plugin-hello-world",
  "docs": "https://github.com/your-org/termix-plugin-hello-world/tree/main/docs",
  "category": "Productivity",
  "icon": "Hand",
  "features": [
    "A tab opened from the sidebar",
    "An admin setting",
    "A table of greetings",
    "An action other parts of Termix can run"
  ],
  "env": [],
  "engine": {
    "termix": ">=26.11.1-0",
    "api": "^1.13"
  },
  "capabilities": [
    "db:own",
    "network:serve",
    "ui:surface",
    "operations:provide"
  ],
  "contributes": {
    "tabs": [
      {
        "id": "hello-world",
        "titleKey": "tab.title",
        "icon": "Hand",
        "openFrom": ["rail"]
      }
    ],
    "permissions": [
      {
        "name": "use",
        "titleKey": "permissions.use.title",
        "descriptionKey": "permissions.use.description",
        "defaultRoles": ["admin", "user"]
      }
    ],
    "settings": {
      "admin": [
        {
          "key": "greeting",
          "type": "string",
          "labelKey": "settings.admin.greeting.label",
          "descriptionKey": "settings.admin.greeting.description",
          "default": "Hello"
        }
      ]
    },
    "operations": {
      "actions": [
        {
          "id": "hello-world.count-notes",
          "titleKey": "operations.count.title",
          "scope": "server",
          "risk": "read",
          "permission": "use",
          "surfaces": {
            "palette": false
          }
        },
        {
          "id": "hello-world.add-note",
          "titleKey": "operations.add.title",
          "icon": "Plus",
          "scope": "server",
          "risk": "change",
          "permission": "use",
          "dryRun": "describe",
          "inputs": [
            {
              "key": "text",
              "type": "string",
              "labelKey": "operations.add.text",
              "required": true
            }
          ]
        }
      ],
      "signals": [
        {
          "id": "hello-world.notes",
          "titleKey": "operations.count.title",
          "read": "hello-world.count-notes",
          "scope": "server",
          "kind": "count"
        }
      ]
    }
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
